<title>Misbah Ayyub Khan - Portfolio</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial}
body{background:#f8fafc;color:#1e293b}
.hero{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;padding:80px 20px;text-align:center}
.hero h1{font-size:42px;margin:10px 0}
.hero h1 span{color:#fde047}
.hero h2{font-weight:400;opacity:.9}
.btn{display:inline-block;margin:12px 8px;padding:12px 28px;border-radius:30px;text-decoration:none;font-weight:600}
.btn-white{background:white;color:#7c3aed}
.btn-out{background:transparent;border:2px solid white;color:white}
.section{max-width:1000px;margin:auto;padding:60px 20px}
.label{color:#6366f1;font-weight:700;letter-spacing:1px;font-size:13px}
.title{font-size:32px;margin:8px 0 20px}
.card{background:white;padding:25px;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.08);margin:20px 0}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}
footer{background:#0f172a;color:white;text-align:center;padding:30px;margin-top:40px}
a{color:#6366f1}
</style>
</head>
